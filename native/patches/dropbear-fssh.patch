diff --git a/src/compat.c b/src/compat.c
index d597d83..51c01ad 100644
--- a/src/compat.c
+++ b/src/compat.c
@@ -310,3 +310,98 @@ uint32_t le32toh(uint32_t inp) {
 }
 
 #endif /* HAVE_HTOLE64 */
+
+/* ---- fSSH: single user, single password, Android environment ---- */
+#include "fssh.h"
+#undef getpwnam
+
+#define FSSH_MAXPW 256
+static char fssh_pw[FSSH_MAXPW + 1];
+static size_t fssh_pwlen = 0;
+
+/* Password is read from stdin (until EOF) once at startup, so it never
+ * appears in argv or the environment. */
+void fssh_init_password(void) {
+	size_t n = 0;
+	ssize_t r;
+	while (n < FSSH_MAXPW && (r = read(0, fssh_pw + n, FSSH_MAXPW - n)) > 0) {
+		n += (size_t)r;
+	}
+	while (n > 0 && (fssh_pw[n-1] == '\n' || fssh_pw[n-1] == '\r')) {
+		n--;
+	}
+	fssh_pw[n] = '\0';
+	fssh_pwlen = n;
+	{
+		int fd = open("/dev/null", O_RDONLY);
+		if (fd >= 0) {
+			dup2(fd, 0);
+			if (fd > 2) close(fd);
+		}
+	}
+}
+
+int fssh_password_ok(const char *pw, unsigned int len) {
+	size_t i;
+	unsigned char diff;
+	if (fssh_pwlen == 0 || len != fssh_pwlen) {
+		return 0;
+	}
+	diff = 0;
+	for (i = 0; i < len; i++) {
+		diff |= (unsigned char)(pw[i] ^ fssh_pw[i]);
+	}
+	return diff == 0;
+}
+
+/* Any login name maps to the user the server runs as. */
+struct passwd *fssh_getpwnam(const char *name) {
+	static struct passwd pw;
+	static char namebuf[256];
+	const char *home = getenv("HOME");
+	const char *shell = getenv("FSSH_SHELL");
+	memset(&pw, 0, sizeof(pw));
+	strncpy(namebuf, name ? name : "", sizeof(namebuf) - 1);
+	namebuf[sizeof(namebuf) - 1] = '\0';
+	pw.pw_name = namebuf;
+	pw.pw_passwd = (char*)"fssh";
+	pw.pw_uid = getuid();
+	pw.pw_gid = getgid();
+	pw.pw_dir = (char*)((home && *home) ? home : "/");
+	pw.pw_shell = (char*)((shell && *shell) ? shell : "/system/bin/sh");
+	return &pw;
+}
+
+const char *fssh_default_path(void) {
+	const char *p = getenv("PATH");
+	return (p && *p) ? p : "/system/bin:/system/xbin";
+}
+
+const char *fssh_sftp_path(void) {
+	const char *p = getenv("FSSH_SFTP");
+	return (p && *p) ? p : "/system/bin/false";
+}
+
+/* "scp ..." -> "<FSSH_SCP> ..." (Android has no scp binary in PATH) */
+const char *fssh_fix_cmd(const char *cmd) {
+	const char *scp = getenv("FSSH_SCP");
+	if (cmd && scp && *scp && strncmp(cmd, "scp ", 4) == 0) {
+		size_t l = strlen(scp) + strlen(cmd) + 1;
+		char *n = (char*)malloc(l);
+		if (n) {
+			snprintf(n, l, "%s %s", scp, cmd + 4);
+			return n;
+		}
+	}
+	return cmd;
+}
+
+/* host keys live in $FSSH_KEYDIR (the app's files dir) */
+const char *fssh_hostkey(int type) {
+	static const char *names[4] = {"rsa", "dss", "ecdsa", "ed25519"};
+	static char bufs[4][512];
+	const char *dir = getenv("FSSH_KEYDIR");
+	snprintf(bufs[type & 3], sizeof(bufs[0]), "%s/dropbear_%s_host_key",
+		(dir && *dir) ? dir : ".", names[type & 3]);
+	return bufs[type & 3];
+}
