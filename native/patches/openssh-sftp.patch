@@ -21,7 +21,46 @@
 #include <sys/resource.h>
 #include <sys/stat.h>
 #include <sys/time.h>
-#include <sys/statvfs.h>
+#include <sys/vfs.h>
+#include <string.h>
+
+/* fSSH: bionic < API 21 has no statvfs(); emulate it on top of statfs() */
+struct fssh_statvfs {
+	unsigned long f_bsize, f_frsize, f_fsid, f_flag, f_namemax;
+	unsigned long long f_blocks, f_bfree, f_bavail, f_files, f_ffree, f_favail;
+};
+#define ST_RDONLY 1
+#define ST_NOSUID 2
+static int
+fssh_conv(int r, struct statfs *s, struct fssh_statvfs *v)
+{
+	if (r != 0)
+		return r;
+	memset(v, 0, sizeof(*v));
+	v->f_bsize = s->f_bsize;
+	v->f_frsize = s->f_bsize;
+	v->f_blocks = s->f_blocks;
+	v->f_bfree = s->f_bfree;
+	v->f_bavail = s->f_bavail;
+	v->f_files = s->f_files;
+	v->f_ffree = s->f_ffree;
+	v->f_favail = s->f_ffree;
+	v->f_namemax = 255;
+	v->f_flag = ((s->f_flags & 1) ? ST_RDONLY : 0) | ((s->f_flags & 2) ? ST_NOSUID : 0);
+	return 0;
+}
+static int
+fssh_statvfs_path(const char *path, struct fssh_statvfs *v)
+{
+	struct statfs s;
+	return fssh_conv(statfs(path, &s), &s, v);
+}
+static int
+fssh_fstatvfs_fd(int fd, struct fssh_statvfs *v)
+{
+	struct statfs s;
+	return fssh_conv(fstatfs(fd, &s), &s, v);
+}
 
